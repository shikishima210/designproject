rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // デコラボ POS。匿名ログイン済みなら読み書きできる(IDとパスワードの確認はPOSの画面で行う)
    match /pos/{name} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && name in ['products', 'discounts', 'accounts'];
    }
    match /posSales/{id} {
      allow read, write: if request.auth != null;
    }
    // それ以外は全部拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
