rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // デコラボ POS。匿名ログイン済みなら読み書きできる(IDとパスワードの確認はPOSの画面で行う)
    match /pos/{name} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && name in ['products', 'discounts', 'accounts'];
    }
    match /posSales/{id} {
      allow read, write: if request.auth != null;
    }
    // 商品写真(1商品1件、縮小したJPEG)
    match /posImages/{id} {
      allow read, delete: if request.auth != null;
      allow create, update: if request.auth != null && request.resource.data.data is string && request.resource.data.data.size() < 400000;
    }
    // それ以外は全部拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
